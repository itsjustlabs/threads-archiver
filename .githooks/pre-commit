#!/usr/bin/env bash
# Pre-commit checks for Threads Archiver.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

fail=0
say() { printf '%s\n' "$*" >&2; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# ── 1. Block files that must never be committed ────────────────────────────────
for f in $staged; do
  case "$f" in
    .env|.env.*|*.pem|*.key)
      if [ "$f" != ".env.example" ]; then
        say "✗ Refusing to commit secret-looking file: $f"; fail=1
      fi ;;
    *.zip|*.tar.gz|downloads/*|*.DS_Store|.DS_Store)
      say "✗ Refusing to commit: $f (archive/export or OS junk)"; fail=1 ;;
    threads-archive-*)
      say "✗ Refusing to commit personal archive export: $f"; fail=1 ;;
  esac
done

# ── 2. Large files (media exports sneak in easily) ─────────────────────────────
for f in $staged; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f")
  if [ "$size" -gt 1048576 ]; then
    say "✗ $f is $((size / 1024)) KB (>1 MB) — exports/media don't belong in the repo"
    fail=1
  fi
done

# ── 3. JavaScript syntax (ES modules) ──────────────────────────────────────────
if command -v node >/dev/null 2>&1; then
  for f in $staged; do
    case "$f" in
      *.js)
        if ! git show ":$f" | node --input-type=module --check 2>/dev/null; then
          say "✗ Syntax error in $f"
          git show ":$f" | node --input-type=module --check 2>&1 | head -5 >&2 || true
          fail=1
        fi ;;
    esac
  done
else
  say "⚠ node not found — skipping JS syntax checks"
fi

# ── 4. JSON validity (manifest.json etc.) ──────────────────────────────────────
for f in $staged; do
  case "$f" in
    *.json)
      if ! git show ":$f" | python3 -c 'import json,sys; json.load(sys.stdin)' 2>/dev/null; then
        say "✗ Invalid JSON: $f"; fail=1
      fi ;;
  esac
done

# ── 5. Secret patterns in staged content ───────────────────────────────────────
# (added lines only; word-boundary patterns to keep false positives low)
# NOTE: no `... | grep -q` pipelines here — with pipefail, grep -q's early
# exit SIGPIPEs the upstream git diff and the "match" reads as failure.
added_all=$(git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+' || true)

SQ="'"
SECRET_PAT="(api[_-]?key|access[_-]?token|client[_-]?secret)[[:space:]\"${SQ}:=]+[A-Za-z0-9_-]{12,}"
SECRET_PAT="${SECRET_PAT}|-----BEGIN (RSA|EC|OPENSSH|PGP) "
SECRET_PAT="${SECRET_PAT}|xox[baprs]-|ghp_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}"
if grep -qiE "$SECRET_PAT" <<< "$added_all"; then
  say "✗ Staged diff contains something that looks like a credential/secret."
  say "  If this is a false positive, commit with --no-verify."
  fail=1
fi

# ── 6. Personal session artifacts in code ──────────────────────────────────────
# Live Threads tokens should never end up hardcoded (they're extracted at runtime)
added_code=$(git diff --cached -U0 -- '*.js' '*.html' | grep -E '^\+' | grep -vE '^\+\+\+' || true)
if grep -qE 'ds_user_id=[0-9]{5,}|csrftoken=[A-Za-z0-9]{10,}|"lsd"[[:space:]]*:[[:space:]]*"[A-Za-z0-9_-]{10,}"' <<< "$added_code"; then
  say "✗ Staged diff appears to contain a live session token/cookie value."
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  say ""
  say "Pre-commit checks failed. Fix the issues or use 'git commit --no-verify' if intentional."
  exit 1
fi
exit 0
